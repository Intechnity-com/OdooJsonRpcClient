<?xml version="1.0" encoding="utf-8"?>
<!-- Code coverage settings (coverlet), used automatically by PortaCapena.OdooJsonRpcClient.Tests. -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <!-- cobertura: PR coverage comment (pr_build.yml), opencover: README badge (code-coverage-badge.yml) -->
          <Format>cobertura,opencover</Format>
          <!-- Shared contains only test models used by tests - not part of the library -->
          <Exclude>[PortaCapena.OdooJsonRpcClient.Shared]*</Exclude>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
